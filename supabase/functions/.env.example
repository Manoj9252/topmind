# Edge Function secrets. Copy to supabase/functions/.env (git-ignored), fill in, then run:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically on hosted projects.
# Leave a line empty if you do not use that integration. See docs/INTEGRATIONS.md.

# Required
SITE_URL=https://your-site.example
DISPATCH_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Top Mind Enterprise <hello@your-domain>
EMAIL_REPLY_TO=etopmind@gmail.com

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Instagram (Meta)
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=v21.0

# Forwarded social enquiries (for example TikTok leads)
SOCIAL_WEBHOOK_SECRET=

# Online payment gateway: billplz, toyyibpay or stripe (leave empty for none).
# Then fill in that provider's lines and turn on "Online payments" in Admin -> Settings.
PAYMENT_GATEWAY=
# Billplz (sandbox: https://www.billplz-sandbox.com)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_BASE_URL=https://www.billplz.com
# ToyyibPay (sandbox: https://dev.toyyibpay.com)
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://toyyibpay.com
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
